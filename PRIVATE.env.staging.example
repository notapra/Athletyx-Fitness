# Staging / production Athletyx Coach API — copy to Railway (or PRIVATE.env.staging, gitignored).
# Deploy athletyx/backend with these values. REQUIRE_AUTH must stay true outside local dev.

# OPTIONAL — leave empty; IronCoach uses evidence RAG without OpenAI tokens
OPENAI_API_KEY=
# Live Form Vision (Google AI Studio Gemini)
GEMINI_API_KEY=
FORM_VISION_RATE_LIMIT_PER_HOUR=180
SERPAPI_API_KEY=
SERPAPI_ENABLED=false
# OPTIONAL — builtin staples work without USDA; set for branded-food fallback
USDA_FDC_API_KEY=

SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=your-staging-anon-key

REQUIRE_AUTH=true
CORS_ORIGINS=http://localhost:5173,https://your-staging-app.vercel.app,capacitor://localhost,https://localhost

COACH_RATE_LIMIT_PER_HOUR=30
COACH_CACHE_ENABLED=true
MCP_RATE_LIMIT_PER_HOUR=120
