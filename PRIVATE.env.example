# =============================================================================
# PRIVATE.env — YOUR SECRETS ONLY (NEVER COMMIT THIS FILE)
# =============================================================================
# Copy to PRIVATE.env and fill in values. PRIVATE.env is gitignored.
# API keys stay on the server (Athletyx backend) — never use VITE_ prefix
# (Vite exposes VITE_* to the browser).
# =============================================================================

# OpenAI — optional; enables LLM coaching in IronLog (gpt-4o-mini)
OPENAI_API_KEY=

# SerpAPI — DuckDuckGo / Google web research for IronCoach
# https://serpapi.com/search.json?engine=duckduckgo
SERPAPI_API_KEY=
SERPAPI_ENABLED=false
SERPAPI_HL=en
SERPAPI_GL=us
# SERPAPI_LOCATION=Austin, Texas, United States

# Production Coach API — JWT validation (same project as frontend Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
REQUIRE_AUTH=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,https://localhost
COACH_RATE_LIMIT_PER_HOUR=30

# Coach response cache — reuse answers to skip OpenAI/SerpAPI on repeat queries
COACH_CACHE_ENABLED=true
COACH_CACHE_TTL_HOURS=168
COACH_CACHE_WEB_TTL_HOURS=24
COACH_CACHE_MAX_ENTRIES=500
