# =============================================================================
# PRIVATE.env — YOUR SECRETS ONLY (NEVER COMMIT THIS FILE)
# =============================================================================
# Copy to PRIVATE.env and fill in values. PRIVATE.env is gitignored.
# API keys stay on the server (Athletyx backend) — never use VITE_ prefix
# (Vite exposes VITE_* to the browser).
# =============================================================================

# OpenAI — OPTIONAL. Leave empty for production-safe RAG coach (research briefs, no token cost).
# Set only if you want LLM coaching via gpt-4o-mini on top of Athletyx RAG.
OPENAI_API_KEY=

# Google AI Studio (Gemini) — Live Form Vision (movement detect + form cues).
# https://aistudio.google.com/apikey — never use VITE_ prefix.
GEMINI_API_KEY=
# Optional model override (default gemini-2.0-flash)
# GEMINI_VISION_MODEL=gemini-2.0-flash
# Live polling is chatty; default 60 analyses/hour per user when auth is on
FORM_VISION_RATE_LIMIT_PER_HOUR=60

# SerpAPI — DuckDuckGo / Google web research for IronCoach
# https://serpapi.com/search.json?engine=duckduckgo
SERPAPI_API_KEY=
SERPAPI_ENABLED=false
SERPAPI_HL=en
SERPAPI_GL=us
# SERPAPI_LOCATION=Austin, Texas, United States

# Production Coach API — JWT validation (same project as frontend Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Local dev may use false; staging/production MUST use true (see PRIVATE.env.staging.example)
REQUIRE_AUTH=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,https://localhost
COACH_RATE_LIMIT_PER_HOUR=30
MCP_RATE_LIMIT_PER_HOUR=120

# Coach response cache — reuse answers to skip OpenAI/SerpAPI on repeat queries
COACH_CACHE_ENABLED=true
COACH_CACHE_TTL_HOURS=168
COACH_CACHE_WEB_TTL_HOURS=24
COACH_CACHE_MAX_ENTRIES=500

# USDA FoodData Central — optional; builtin common foods work without a key
USDA_FDC_API_KEY=
