# Supabase — copy to .env and fill in your project values
# Dashboard: https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Hosted Athletyx Coach API (dev uses Vite proxy /api/athletyx → localhost:8000).
# Production / staging: set to the coach endpoint (…/api/coach). The client derives
# /api/nutrition and /api/mcp from that base via src/utils/athletyxApiUrls.js.
# VITE_ATHLETYX_API_URL=https://api.yourdomain.com/api/coach

# Optional error tracking (production)
# VITE_SENTRY_DSN=
