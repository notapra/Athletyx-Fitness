# Staging frontend — copy to .env.staging.local (gitignored) or set in Vercel Preview env

VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-anon-key

# Staging Athletyx Coach API (REQUIRE_AUTH=true on server).
# Must end with /api/coach — nutrition + MCP paths are resolved from this base.
VITE_ATHLETYX_API_URL=https://your-staging-api.railway.app/api/coach

# Optional
# VITE_SENTRY_DSN=
