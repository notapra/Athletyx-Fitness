{
  "mcpServers": {
    "athletyx-identity": {
      "command": "python",
      "args": ["PATH/TO/athletyx.mcp/server.py"],
      "env": {
        "MCP_REQUIRE_AUTH": "true",
        "ATHLETYX_DB_BACKEND": "supabase",
        "ATHLETYX_MCP_DOMAIN": "identity",
        "ATHLETYX_MCP_JWT": "PASTE_FROM_IRONLOG_SETTINGS_MCP_ACCESS",
        "SUPABASE_URL": "https://YOUR_PROJECT.supabase.co",
        "SUPABASE_ANON_KEY": "YOUR_ANON_KEY"
      }
    },
    "athletyx-workouts": {
      "command": "python",
      "args": ["PATH/TO/athletyx.mcp/server.py"],
      "env": {
        "MCP_REQUIRE_AUTH": "true",
        "ATHLETYX_DB_BACKEND": "supabase",
        "ATHLETYX_MCP_DOMAIN": "workouts",
        "ATHLETYX_MCP_JWT": "PASTE_FROM_IRONLOG_SETTINGS_MCP_ACCESS",
        "SUPABASE_URL": "https://YOUR_PROJECT.supabase.co",
        "SUPABASE_ANON_KEY": "YOUR_ANON_KEY"
      }
    }
  }
}
